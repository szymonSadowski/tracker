# Database (docker compose up -d db provides this locally)
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker
# Only for a drain-based deployment (docs/deploy.md Path C): a direct, unpooled connection used by
# job execution, while page rendering keeps using the pooled DATABASE_URL. Leave unset otherwise —
# every container deployment runs both on DATABASE_URL.
DATABASE_URL_DIRECT=

# GitHub App — see docs/github-app.md for how to create it
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM contents, or the same PEM base64-encoded
GITHUB_APP_PRIVATE_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Reserved for the deferred webhook path; unused in this change
GITHUB_WEBHOOK_SECRET=

# Sessions
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000

# Sync tuning (defaults shown)
# How far back a repository's automatic backfill reaches when it is connected. A starting point,
# not a ceiling: members extend coverage earlier with a history sync from settings.
BACKFILL_WINDOW_DAYS=90
# Pages one history sync job walks before handing the worker back
HISTORY_PAGES_PER_RUN=5
SYNC_INTERVAL_MINUTES=15
SYNC_OVERLAP_MINUTES=30
RATE_LIMIT_SAFETY_THRESHOLD=200
ON_DEMAND_SYNC_DEBOUNCE_SECONDS=120
PERMISSION_CACHE_SECONDS=300

# Job execution — only for a drain-based deployment (docs/deploy.md Path C).
# The drain endpoint refuses every request while this is unset, so leaving it blank keeps the
# endpoint inert. On Vercel, CRON_SECRET is read as a fallback because its scheduler already sends
# it as a bearer token.
JOBS_DRAIN_SECRET=
# Wall-clock budget for one drain pass, and the reserve held back from it so a pass never starts a
# job it cannot finish. Tune from the counts the endpoint reports.
JOBS_DRAIN_BUDGET_MS=60000
JOBS_DRAIN_RESERVE_MS=30000
